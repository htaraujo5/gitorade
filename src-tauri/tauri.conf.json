{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Gitorade",
  "version": "0.1.0",
  "identifier": "com.gitorade.desktop",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Gitorade",
        "width": 760,
        "height": 440,
        "minWidth": 760,
        "minHeight": 440,
        "center": true,
        "resizable": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["msi", "nsis"],
    "publisher": "Gitorade",
    "copyright": "Copyright © 2026 Gitorade",
    "category": "DeveloperTool",
    "shortDescription": "Cliente Git com identidades por repositório.",
    "longDescription": "Gitorade é um cliente Git para Windows focado em gerenciamento robusto de múltiplas identidades (nome/email/SSH) por repositório, com overrides no nível do commit.",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "windows": {
      "nsis": {
        "installMode": "currentUser",
        "languages": ["PortugueseBR", "English"],
        "displayLanguageSelector": true,
        "installerIcon": "icons/icon.ico",
        "startMenuFolder": "Gitorade"
      }
    }
  }
}
